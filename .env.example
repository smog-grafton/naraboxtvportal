APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=https://naraboxtv.com
PARTNER_TIMEZONE=Africa/Kampala
TRENDING_TIMEZONE=Africa/Kampala

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Set true to require email verification after register and SMS OTP for phone login.
AUTH_REQUIRE_VERIFICATION_CODES=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=21660
# Run long imports on dedicated workers, e.g.
# php artisan queue:work database --queue=tele-ob-imports,contabo-imports --timeout=21600 --tries=1

CACHE_STORE=database
# Presence is shared by API and Filament processes; use Redis in a larger
# deployment, or the database cache when Redis is not available.
PRESENCE_CACHE_STORE=database
SECURITY_CACHE_STORE=database
# Comma-separated IPs/CIDRs of your actual Cloudflare/load-balancer proxies.
# Leave empty when PHP is directly internet-facing. Never use "*" here.
SECURITY_TRUSTED_PROXIES=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Account, registration, and payment abuse protection
# --------------------------------------------------------------------------
SECURITY_ENABLED=true
REGISTRATION_SECURITY_ENABLED=true
REGISTRATION_IP_MAX_ATTEMPTS=3
REGISTRATION_IP_WINDOW_MINUTES=60
REGISTRATION_EMAIL_MAX_ATTEMPTS=3
REGISTRATION_EMAIL_WINDOW_MINUTES=1440
REGISTRATION_DEVICE_MAX_ATTEMPTS=3
REGISTRATION_DEVICE_WINDOW_MINUTES=60

PAYMENT_SECURITY_ENABLED=true
PAYMENT_USER_MAX_ATTEMPTS=10
PAYMENT_USER_WINDOW_MINUTES=60
PAYMENT_PROVIDER_ID_MAX_ATTEMPTS=10
PAYMENT_PROVIDER_ID_WINDOW_MINUTES=60
PAYMENT_IP_MAX_ATTEMPTS=20
PAYMENT_IP_WINDOW_MINUTES=60
PAYMENT_DEVICE_MAX_ATTEMPTS=10
PAYMENT_DEVICE_WINDOW_MINUTES=60
PAYMENT_PAYER_MAX_ATTEMPTS=5
PAYMENT_PAYER_WINDOW_MINUTES=60
PAYMENT_MIN_SECONDS_BETWEEN_ATTEMPTS=20
PAYMENT_MAX_PENDING_PER_USER=1
PAYMENT_PENDING_EXPIRY_MINUTES=15
PAYMENT_UNIQUE_PAYER_WINDOW_MINUTES=1440
PAYMENT_MAX_UNIQUE_PAYERS_PER_USER=3
PAYMENT_MAX_UNIQUE_PAYERS_PER_PROVIDER=3
PAYMENT_MAX_UNIQUE_PAYERS_PER_IP=5
PAYMENT_MAX_UNIQUE_PAYERS_PER_DEVICE=3
PAYMENT_ENUMERATION_ENABLED=true
PAYMENT_ENUMERATION_WINDOW_MINUTES=30
PAYMENT_ENUMERATION_MIN_UNIQUE_NUMBERS=5
PAYMENT_ENUMERATION_PREFIX_LENGTH=9
PAYMENT_ENUMERATION_MAX_NUMERIC_SPREAD=100
PAYMENT_ENUMERATION_AUTO_RESTRICT=true
NEW_ACCOUNT_PAYMENT_PROTECTION_ENABLED=true
NEW_ACCOUNT_PAYMENT_WINDOW_MINUTES=30
NEW_ACCOUNT_PAYMENT_MAX_ATTEMPTS=3
PAYMENT_SECURITY_LOCK_SECONDS=30

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Comma-separated Apple Sign-In audiences accepted by the API.
# For native iOS this is usually the app Bundle ID; for web/service flows use the Services ID.
APPLE_CLIENT_IDS=

# Public API clients (Next.js + mobile): when APP_API_KEY_ENABLED=true, send this value
# as header X-API-KEY on every /api/v1/* request. Must match NEXT_PUBLIC_API_KEY (web)
# and EXPO_PUBLIC_API_KEY (app). Not stored in the database.
APP_API_KEY=
APP_API_KEY_ENABLED=true
# APP_API_KEY_HEADER=X-API-KEY

# Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_ENV=live
FLW_CURRENCY=UGX
FLW_WEBHOOK_SECRET_HASH=

# ioTec
IOTEC_CLIENT_ID=
IOTEC_CLIENT_SECRET=
IOTEC_GRANT_TYPE=client_credentials
IOTEC_ID_BASE_URL=https://id.iotec.io
IOTEC_PAY_BASE_URL=https://pay.iotec.io
IOTEC_WALLET_ID=
IOTEC_WEBHOOK_TOKEN=

# PawaPay
PAWAPAY_ENV=sandbox
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_VERIFY_CALLBACK_SIGNATURE=true
PAWAPAY_WEBHOOK_TOKEN=
PAWAPAY_REFUND_WEBHOOK_TOKEN=

# Push notifications
PUSH_PROVIDER=log
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
ONESIGNAL_API_BASE_URL=https://api.onesignal.com

# CDN Media Server (naraboxtv-cdn)
# Keep this aligned with the CDN app, not the portal APP_URL above.
CDN_API_BASE_URL=http://127.0.0.1:8001
CDN_API_TOKEN=
CDN_IMPORT_MODE_DEFAULT=now
CDN_CONNECT_TIMEOUT=30
CDN_TIMEOUT=300
CDN_RETRY_TIMES=2
CDN_RETRY_SLEEP_MS=800
CDN_FORCE_IP_RESOLVE=v4
CDN_INGEST_SECRET=
CDN_INGEST_ENDPOINT=/api/ingest/asset-source-upload
PORTAL_FETCH_PROXY_TOKEN=
CDN_PYTHON_WORKER_ENABLED=false
CDN_PYTHON_WORKER_HOSTS=mobifliks.info,mobifliks.com
CDN_USE_PLAYBACK_MANIFEST=true
CDN_REMOTE_PLAYBACK_MANIFEST_LOOKUP=false
CDN_HLS_READINESS_CHECK_ENABLED=true
CDN_HLS_READINESS_CHECK_ON_PLAYBACK=false
CDN_HLS_READINESS_TTL_MINUTES=30
CDN_HLS_READINESS_CONNECT_TIMEOUT=3
CDN_HLS_READINESS_TIMEOUT=8
CDN_HLS_AUTO_DEACTIVATE_UNREADY=true
CDN_HLS_AUTO_QUEUE_MISSING=false

# NBX Engine (new CDN processing VPS)
NBX_ENGINE_ENABLED=false
NBX_ENGINE_BASE_URL=
NBX_ENGINE_API_KEY=
NBX_ENGINE_WEBHOOK_SECRET=
NBX_ENGINE_CALLBACK_URL="${APP_URL}/api/nbx/webhook"
NBX_WEBHOOK_TOLERANCE_SECONDS=300
NBX_ENGINE_TIMEOUT=300
NBX_ENGINE_CONNECT_TIMEOUT=15
NBX_ENGINE_RETRY_TIMES=1
NBX_ENGINE_RETRY_SLEEP_MS=800
NBX_ENGINE_SOURCE_DISCOVERY=true
NBX_LEGACY_CDN_BASE_URL="${CDN_API_BASE_URL}"
NBX_LEGACY_CDN_HOSTS=cdn.naraboxtv.com
NBX_SCHEDULED_SYNC_ENABLED=true
NBX_SCHEDULED_SYNC_EVERY_MINUTES=5
NBX_SCHEDULED_BACKFILL_ENABLED=false
NBX_SCHEDULED_BACKFILL_LIMIT=10
NBX_SCHEDULED_CLEANUP_ENABLED=true

# Bunny Stream
# Keep the API key server-side only. Do not expose it as a NEXT_PUBLIC_* value.
BUNNY_STREAM_ENABLED=false
BUNNY_STREAM_API_BASE_URL=https://video.bunnycdn.com
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=651140
BUNNY_STREAM_PULL_ZONE_HOSTNAME=vz-e5f45c78-720.b-cdn.net
BUNNY_STREAM_COLLECTION_ID=
BUNNY_STREAM_TIMEOUT=300
BUNNY_STREAM_CONNECT_TIMEOUT=15
BUNNY_STREAM_RETRY_TIMES=1
BUNNY_STREAM_RETRY_SLEEP_MS=800
BUNNY_STREAM_ENABLED_RESOLUTIONS=
BUNNY_STREAM_REFRESH_METADATA_ON_PLAYBACK=false

# Contabo Object Storage
# File uploads use Contabo's S3-compatible endpoint. The REST API values below are only
# for account/product management actions such as listing storages and reading stats.
CONTABO_OBJECT_STORAGE_ENABLED=false
CONTABO_OBJECT_STORAGE_DISK=contabo
CONTABO_OBJECT_STORAGE_ENDPOINT=https://usc1.contabostorage.com
CONTABO_OBJECT_STORAGE_BUCKET=nbx
CONTABO_OBJECT_STORAGE_REGION=US-central
# Optional: leave blank when Contabo API credentials are set; the app can discover these S3 keys.
CONTABO_OBJECT_STORAGE_ACCESS_KEY=
CONTABO_OBJECT_STORAGE_SECRET_KEY=
CONTABO_OBJECT_STORAGE_PUBLIC_URL=https://usc1.contabostorage.com/d052ede4e40a478d92ab1a7ad3f1e435:nbx
CONTABO_OBJECT_STORAGE_PATH_PREFIX=videos
CONTABO_OBJECT_STORAGE_VISIBILITY=public
CONTABO_OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true
CONTABO_OBJECT_STORAGE_CONNECT_TIMEOUT=30
CONTABO_OBJECT_STORAGE_TIMEOUT=21600

# --------------------------------------------------------------------------
# Multi-bucket storage targets (config/storage_targets.php)
# --------------------------------------------------------------------------
# Two logical targets: the legacy bucket (contabo_nbx / "nbx", ~87.73% full)
# and the new bucket (contabo_nb_nbx / "nb-nbx", empty). Unset CONTABO_NBX_*
# values fall back to the CONTABO_OBJECT_STORAGE_* values above, so upgrading
# does not require duplicating existing production secrets immediately.
# Portal sends NBX a logical key (contabo_nbx | contabo_nb_nbx | auto) —
# never these credentials.

CONTABO_NBX_ENABLED=true
CONTABO_NBX_DISK=contabo_nbx
CONTABO_NBX_ENDPOINT=https://usc1.contabostorage.com
CONTABO_NBX_REGION=US-central
CONTABO_NBX_BUCKET=nbx
CONTABO_NBX_PUBLIC_URL=https://usc1.contabostorage.com/d052ede4e40a478d92ab1a7ad3f1e435:nbx
CONTABO_NBX_PATH_PREFIX=videos
CONTABO_NBX_CAPACITY_BYTES=536870912000
CONTABO_NBX_RESERVE_PERCENT=10
CONTABO_NBX_PRIORITY=20
# Leave blank to fall back to CONTABO_OBJECT_STORAGE_ACCESS_KEY/SECRET_KEY.
CONTABO_NBX_ACCESS_KEY_ID=
CONTABO_NBX_SECRET_ACCESS_KEY=
# Operator-maintained snapshot (Contabo exposes no bucket quota API). Update
# after running storage-targets:recalculate-usage, or whenever the Contabo
# dashboard is checked manually.
CONTABO_NBX_KNOWN_USED_BYTES=471073193164
CONTABO_NBX_KNOWN_USED_AT=

CONTABO_NB_NBX_ENABLED=true
CONTABO_NB_NBX_DISK=contabo_nb_nbx
CONTABO_NB_NBX_ENDPOINT=https://usc1.contabostorage.com
CONTABO_NB_NBX_REGION=US-central
CONTABO_NB_NBX_BUCKET=nb-nbx
CONTABO_NB_NBX_PUBLIC_URL=https://usc1.contabostorage.com/5fa286e37e8b403abc5b60ba900a5c3d:nb-nbx
CONTABO_NB_NBX_PATH_PREFIX=videos
CONTABO_NB_NBX_CAPACITY_BYTES=536870912000
CONTABO_NB_NBX_RESERVE_PERCENT=10
CONTABO_NB_NBX_PRIORITY=100
# Separate credentials — the two Contabo services are NOT assumed to share keys.
CONTABO_NB_NBX_ACCESS_KEY_ID=
CONTABO_NB_NBX_SECRET_ACCESS_KEY=
CONTABO_NB_NBX_KNOWN_USED_BYTES=0
CONTABO_NB_NBX_KNOWN_USED_AT=

CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_WRITABLE=true
CLOUDFLARE_R2_DISK=r2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
