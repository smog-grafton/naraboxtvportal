CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://nbxgen.naraboxtv.com
CLOUDFLARE_R2_R2_DEV_URL=https://<public-bucket-id>.r2.dev
CLOUDFLARE_R2_PATH_PREFIX=videos
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false
CLOUDFLARE_R2_CAPACITY_BYTES=10995116277760
CLOUDFLARE_R2_RESERVE_PERCENT=5
CLOUDFLARE_R2_PRIORITY=200
CLOUDFLARE_R2_KNOWN_USED_BYTES=0
CLOUDFLARE_R2_KNOWN_USED_AT=

MEDIA_STORAGE_DEFAULT_TARGET=auto
MEDIA_STORAGE_AUTO_SELECTION_ENABLED=true
MEDIA_STORAGE_USAGE_STALE_AFTER_MINUTES=30
MEDIA_STORAGE_TRANSCODE_SAFETY_MULTIPLIER=2.0
MEDIA_STORAGE_SOFT_CAP_OVERRIDE_PERMISSION=storage.override-soft-cap

CONTABO_API_BASE_URL=https://api.contabo.com
CONTABO_AUTH_URL=https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token
CONTABO_API_CLIENT_ID=
CONTABO_API_CLIENT_SECRET=
CONTABO_API_USERNAME=
CONTABO_API_PASSWORD=
